ARG DOCKER_REGISTRY=docker.io
ARG VLLM_BASE_IMAGE=vllm/vllm-openai:v0.28.0
ARG MOONCAKE_PROFILE=0.3.12.post1
ARG TARGET_CUDA_VERSION=auto
ARG CUDA_DEVEL_PACKAGES=auto
ARG MOONCAKE_BUILD_JOBS=8

####
# Stage: Base Configure
####

FROM ${DOCKER_REGISTRY}/${VLLM_BASE_IMAGE} AS configured-base

ARG MOONCAKE_PROFILE
ARG TARGET_CUDA_VERSION
ARG CUDA_DEVEL_PACKAGES
ARG MOONCAKE_BUILD_JOBS

# The upstream vLLM image runs as root. Keep the internal trust and package
# repository configuration in both the builder and final runtime image.
# hadolint ignore=DL3002,DL3066
USER root

COPY certs/ /opt/certs/
COPY pip.conf /etc/pip.conf
COPY sources.list /etc/apt/sources.list

RUN set -eux; \
    test -s /etc/pip.conf; \
    test -s /etc/apt/sources.list; \
    rm -fv /etc/apt/sources.list.d/*.list; \
    test -n "$(find /opt/certs -maxdepth 1 -type f -name '*.crt' -print -quit)"; \
    find /opt/certs -maxdepth 1 -type f -name '*.crt' \
      -exec cp -v {} /usr/local/share/ca-certificates/ \;; \
    update-ca-certificates; \
    rm -rf /opt/certs

####
# Stage: Mooncake Builder
####
FROM configured-base AS mooncake-builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}

WORKDIR /opt/mooncake

COPY docker/mooncake/locks/ /opt/mooncake/locks/
COPY docker/mooncake/requirements-build.txt /opt/mooncake/requirements-build.txt
COPY docker/mooncake/scripts/detect-cuda-contract.sh /opt/mooncake/detect-cuda-contract.sh
COPY docker/mooncake/scripts/verify-source-lock.sh /opt/mooncake/verify-source-lock.sh
COPY docker/mooncake/scripts/verify-install.py /opt/mooncake/verify-install.py
COPY docker/mooncake/vendor/ /opt/mooncake/vendor/

# Select a Mooncake source profile independently from the vLLM/CUDA base.
RUN set -eux; \
    PROFILE_LOCK="/opt/mooncake/locks/${MOONCAKE_PROFILE}.env"; \
    test -f "${PROFILE_LOCK}"; \
    cp "${PROFILE_LOCK}" /opt/mooncake/SOURCE_LOCK.env; \
    chmod 0755 /opt/mooncake/detect-cuda-contract.sh \
               /opt/mooncake/verify-source-lock.sh; \
    /opt/mooncake/detect-cuda-contract.sh \
      "${TARGET_CUDA_VERSION}" \
      /opt/mooncake/CUDA_CONTRACT.env; \
    cat /opt/mooncake/SOURCE_LOCK.env; \
    cat /opt/mooncake/CUDA_CONTRACT.env

# The base image is the source of truth for CUDA ABI. If it is a runtime image
# without nvcc/headers, derive matching NVIDIA APT packages from torch.version.cuda.
# CUDA_DEVEL_PACKAGES can override this for a custom mirror.
# hadolint ignore=DL3008
RUN set -eux; \
    . /opt/mooncake/CUDA_CONTRACT.env; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        libc6 \
        libc6-dev \
        libasio-dev \
        libboost-all-dev \
        libcurl4-openssl-dev \
        libgoogle-glog-dev \
        libgflags-dev \
        libibverbs-dev \
        libjsoncpp-dev \
        libnuma-dev \
        libssl-dev \
        libunwind-dev \
        libyaml-cpp-dev \
        ninja-build \
        patchelf \
        pkg-config \
        tar; \
    if ! command -v nvcc >/dev/null 2>&1 || \
       [ ! -f /usr/local/cuda/include/cuda_runtime.h ]; then \
        if [ "${CUDA_DEVEL_PACKAGES}" = "auto" ]; then \
            RESOLVED_CUDA_DEVEL_PACKAGES="cuda-nvcc-${CUDA_APT_SUFFIX} cuda-cudart-dev-${CUDA_APT_SUFFIX} cuda-driver-dev-${CUDA_APT_SUFFIX}"; \
        else \
            RESOLVED_CUDA_DEVEL_PACKAGES="${CUDA_DEVEL_PACKAGES}"; \
        fi; \
        test -n "${RESOLVED_CUDA_DEVEL_PACKAGES}"; \
        echo "Installing CUDA development packages: ${RESOLVED_CUDA_DEVEL_PACKAGES}"; \
        apt-get install -y --no-install-recommends ${RESOLVED_CUDA_DEVEL_PACKAGES}; \
    fi; \
    command -v nvcc; \
    test -f /usr/local/cuda/include/cuda_runtime.h; \
    rm -rf /var/lib/apt/lists/*

# Extract exactly the archive declared by the selected source profile. Multiple
# Mooncake versions may coexist in vendor/ without making the build ambiguous.
RUN set -eux; \
    . /opt/mooncake/SOURCE_LOCK.env; \
    SOURCE_TAR="/opt/mooncake/vendor/${MOONCAKE_SOURCE_ARCHIVE}"; \
    CHECKSUM_FILE="${SOURCE_TAR}.sha256"; \
    test -f "${SOURCE_TAR}"; \
    if [ -f "${CHECKSUM_FILE}" ]; then \
        cd /opt/mooncake/vendor; \
        sha256sum --check "$(basename "${CHECKSUM_FILE}")"; \
    elif [ -f /opt/mooncake/vendor/SHA256SUMS ]; then \
        cd /opt/mooncake/vendor; \
        grep -F "  ${MOONCAKE_SOURCE_ARCHIVE}" SHA256SUMS | sha256sum --check -; \
    else \
        echo "No checksum file found for ${MOONCAKE_SOURCE_ARCHIVE}" >&2; \
        exit 1; \
    fi; \
    tar -xzf "${SOURCE_TAR}" -C /opt/mooncake; \
    test -f /opt/mooncake/Mooncake/CMakeLists.txt; \
    MOONCAKE_LOCK_FILE=/opt/mooncake/SOURCE_LOCK.env \
      /opt/mooncake/verify-source-lock.sh /opt/mooncake/Mooncake; \
    command -v python3; \
    python3 -c \
      'import os, sysconfig; header=os.path.join(sysconfig.get_paths()["include"], "Python.h"); assert os.path.isfile(header), header'; \
    python3 -m pip install \
      --no-cache-dir \
      --requirement /opt/mooncake/requirements-build.txt

WORKDIR /opt/mooncake

# yalantinglibs is a pinned Mooncake submodule, but Mooncake resolves it as an
# installed CMake package. Build the version carried by the selected profile.
RUN set -eux; \
    cmake \
      -S /opt/mooncake/Mooncake/extern/yalantinglibs \
      -B /opt/mooncake/yalantinglibs-build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_BENCHMARK=OFF \
      -DBUILD_UNIT_TESTS=OFF \
      -DCMAKE_INSTALL_PREFIX=/usr/local; \
    cmake --build /opt/mooncake/yalantinglibs-build \
      --parallel "${MOONCAKE_BUILD_JOBS}"; \
    cmake --install /opt/mooncake/yalantinglibs-build

# Build only the Python Transfer Engine. Store/etcd/Go are deliberately off.
# USE_MNNVL compiles protocol "nvlink"; USE_INTRA_NVLINK compiles
# protocol "nvlink_intra".
RUN set -eux; \
    cmake \
      -S /opt/mooncake/Mooncake \
      -B /opt/mooncake/Mooncake/build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_EXAMPLES=ON \
      -DBUILD_SHARED_LIBS=OFF \
      -DBUILD_UNIT_TESTS=OFF \
      -DWITH_TE=ON \
      -DWITH_STORE=OFF \
      -DWITH_STORE_RUST=OFF \
      -DWITH_STORE_GO=OFF \
      -DWITH_P2P_STORE=OFF \
      -DWITH_RUST_EXAMPLE=OFF \
      -DWITH_EP=OFF \
      -DUSE_CUDA=ON \
      -DUSE_MNNVL=ON \
      -DUSE_INTRA_NVLINK=ON \
      -DUSE_TCP=ON \
      -DUSE_HTTP=ON \
      -DUSE_ETCD=OFF \
      -DUSE_REDIS=OFF \
      -DUSE_TENT=OFF \
      -DWITH_METRICS=ON \
      -DPython3_EXECUTABLE="$(command -v python3)"; \
    cmake --build /opt/mooncake/Mooncake/build \
      --parallel "${MOONCAKE_BUILD_JOBS}"; \
    grep -Fx 'USE_CUDA:BOOL=ON' /opt/mooncake/Mooncake/build/CMakeCache.txt; \
    grep -Fx 'USE_MNNVL:BOOL=ON' /opt/mooncake/Mooncake/build/CMakeCache.txt; \
    grep -Fx 'USE_INTRA_NVLINK:BOOL=ON' /opt/mooncake/Mooncake/build/CMakeCache.txt; \
    grep -Fx 'WITH_STORE:BOOL=OFF' /opt/mooncake/Mooncake/build/CMakeCache.txt; \
    mkdir -p /opt/mooncake/build-info; \
    cp /opt/mooncake/SOURCE_LOCK.env /opt/mooncake/build-info/SOURCE_LOCK.env; \
    cp /opt/mooncake/CUDA_CONTRACT.env /opt/mooncake/build-info/CUDA_CONTRACT.env; \
    grep -E '^(USE_CUDA|USE_MNNVL|USE_INTRA_NVLINK|WITH_STORE|WITH_STORE_RUST|USE_ETCD):' \
      /opt/mooncake/Mooncake/build/CMakeCache.txt \
      > /opt/mooncake/build-info/CMAKE_FEATURES.txt

WORKDIR /opt/mooncake/Mooncake

# Mooncake uses a separate package name for CUDA 13. Derive CU13_BUILD from the
# actual CUDA ABI of the selected vLLM base instead of requiring another arg.
RUN set -eux; \
    . /opt/mooncake/CUDA_CONTRACT.env; \
    PYTHON_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"; \
    PYTHON_VERSION="${PYTHON_VERSION}" \
    OUTPUT_DIR=/opt/mooncake/dist \
    BUILD_DIR=build \
    CU13_BUILD="${MOONCAKE_CU13_BUILD}" \
    CI=false \
    FREE_BUILD_DIR=0 \
      ./scripts/build_wheel.sh; \
    set -- /opt/mooncake/dist/*.whl; \
    test "$#" -eq 1; \
    test -f "$1"

####
# Stage: vLLM Runtime Image
####
FROM configured-base AS runtime

ARG VLLM_BASE_IMAGE
ARG MOONCAKE_PROFILE

# Preserve the upstream vLLM image execution user and entrypoint contract.
# hadolint ignore=DL3002,DL3066
USER root

ENV PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --from=mooncake-builder /opt/mooncake/dist/ /tmp/mooncake-dist/
COPY --from=mooncake-builder /opt/mooncake/build-info/ /opt/mooncake-build-info/
COPY docker/mooncake/scripts/verify-install.py /usr/local/bin/verify-mooncake-install

RUN set -eux; \
    . /opt/mooncake-build-info/SOURCE_LOCK.env; \
    python3 -m pip uninstall -y \
      mooncake-transfer-engine \
      mooncake-transfer-engine-cuda13 || true; \
    if [ -n "${MOONCAKE_RUNTIME_DEPS:-}" ]; then \
        python3 -m pip install \
          --no-cache-dir \
          ${MOONCAKE_RUNTIME_DEPS}; \
    fi; \
    python3 -m pip install \
      --no-index \
      --no-deps \
      --no-cache-dir \
      --force-reinstall \
      /tmp/mooncake-dist/*.whl; \
    chmod 0755 /usr/local/bin/verify-mooncake-install; \
    python3 /usr/local/bin/verify-mooncake-install; \
    rm -rf /tmp/mooncake-dist

LABEL ai.mooncake.profile="${MOONCAKE_PROFILE}" \
      ai.mooncake.transport.nvlink="true" \
      ai.mooncake.transport.nvlink_intra="true" \
      ai.vllm.base-image="${VLLM_BASE_IMAGE}"
