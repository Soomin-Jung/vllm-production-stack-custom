{
  "id": null,
  "uid": "pd-cell-overview",
  "title": "vLLM P/D Cell — Professional Overview",
  "description": "P/D disaggregation 운영·성능 분석 대시보드. 모든 rate/increase 쿼리는 $__rate_interval 또는 $__range를 사용해 5분 같은 짧은 범위에서도 의미가 유지되도록 설계했습니다.",
  "tags": [
    "vllm",
    "pd-disaggregation",
    "inference",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\"}, namespace)",
          "refId": "ns"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\"}, model)",
          "refId": "model"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pd_role",
        "type": "query",
        "label": "P/D Role",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\"}, pd_role)",
          "refId": "role"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pd_engine",
        "type": "query",
        "label": "P/D Engine",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\"}, pd_engine)",
          "refId": "engine"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Target / Traffic Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P/D Engine Targets UP",
      "description": "선택한 namespace/model 범위에서 Prometheus가 정상 scrape 중인 Prefill/Decode 엔진 수입니다. 기대 엔진 수보다 작으면 성능 지표를 보기 전에 target discovery/health부터 확인하세요.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "targets"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P/D Router Targets UP",
      "description": "Cell-local vllm-router의 :29000/metrics scrape 상태입니다. 0이면 P/D 요청 경로와 별개로 router observability가 끊긴 상태입니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kubernetes-vllm-pd-router\",namespace=~\"$namespace\",model=~\"$model\"})",
          "legendFormat": "routers"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in Selected Range",
      "description": "현재 대시보드 시간 범위($__range) 동안 완료된 요청 수입니다. 24h 같은 고정 window를 쓰지 않아 최근 5분으로 줄여도 같은 의미를 유지합니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vllm:request_success_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range]))",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Preemptions in Selected Range",
      "description": "선택한 시간 범위에서 발생한 preemption 수입니다. KV 압박이나 scheduler capacity 부족의 직접 신호입니다. 0에 가까운 상태가 정상적입니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vllm:num_preemptions_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range]))",
          "legendFormat": "preemptions"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Throughput by Role",
      "description": "완료 요청의 초당 처리량입니다. $__rate_interval을 사용하므로 5분/1시간/1일 등 범위 변경 시 window가 자동 조정됩니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role) (rate(vllm:request_success_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval]))",
          "legendFormat": "{{pd_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Running / Waiting Requests",
      "description": "실행 중 요청과 대기 요청을 엔진별로 함께 봅니다. Decode waiting이 지속 상승하면 decode capacity 부족, Prefill waiting 상승은 prompt compute/queue 병목 가능성이 큽니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_engine) (vllm:num_requests_running{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "running {{pd_engine}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pd_engine) (vllm:num_requests_waiting{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "waiting {{pd_engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prompt / Generation Token Throughput",
      "description": "Prefill prompt token 처리율과 Decode generation token 처리율입니다. P/D ratio 튜닝에서 양쪽의 실제 workload 강도를 비교하는 핵심 패널입니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role) (rate(vllm:prompt_tokens_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval]))",
          "legendFormat": "prompt {{pd_role}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pd_role) (rate(vllm:generation_tokens_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval]))",
          "legendFormat": "generation {{pd_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Waiting Requests by Reason",
      "description": "vLLM이 capacity/deferred 이유별 waiting metric을 노출하는 버전에서 scheduler 대기 원인을 분리합니다. metric이 없는 버전에서는 이 패널만 No data일 수 있습니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role,reason) (vllm:num_requests_waiting_by_reason{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "{{pd_role}} / {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "2. Latency / Request Shape",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "TTFT p50 / p95 / p99",
      "description": "Time To First Token. Prefill 성능과 queueing 영향을 가장 직접적으로 보여줍니다. p95/p99가 p50 대비 급격히 벌어지면 tail queue 또는 긴 prompt 간섭을 의심하세요.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le,pd_role) (rate(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pd_role}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pd_role}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le,pd_role) (rate(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "p99 {{pd_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Decode p95 ITL / TPOT",
      "description": "ITL은 토큰 간 간격, TPOT은 요청 단위 output-token 당 시간입니다. Decode capacity/MTP 튜닝에서 가장 중요한 latency 지표입니다. 구/신 metric 이름을 OR로 호환합니다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:inter_token_latency_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "ITL p95 {{pd_role}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:request_time_per_output_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval]))) or histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:time_per_output_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "TPOT p95 {{pd_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "E2E / Queue p95",
      "description": "전체 요청 latency와 queue time을 같이 봅니다. E2E 상승이 queue 상승과 동반되면 compute 자체보다 capacity/scheduling 병목일 가능성이 큽니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:e2e_request_latency_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "E2E p95 {{pd_role}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:request_queue_time_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "Queue p95 {{pd_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Prefill / Decode Phase p95",
      "description": "요청 내부에서 Prefill과 Decode phase에 실제 소비된 시간을 비교합니다. P/D 비대칭 튜닝 시 어느 phase가 wall-time을 지배하는지 확인하는 용도입니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,pd_role) (rate(vllm:request_prefill_time_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])))",
          "legendFormat": "Prefill p95 {{pd_role}}"
        },
        {
          "refId": "B",
