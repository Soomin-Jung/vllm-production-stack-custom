{
  "id": null,
  "uid": "pd-cell-overview",
  "title": "vLLM P/D Cell — Professional Overview",
  "description": "P/D disaggregation 운영·성능 분석 대시보드. serving scrape interval을 15s로 명시하고, counter/rate는 15s Min step + $__rate_interval, latency/token percentile은 선택 범위의 histogram increase를 사용해 Last 5m 같은 짧은 수동 테스트에서도 안정적으로 동작하도록 설계했습니다.",
  "tags": [
    "vllm",
    "pd-disaggregation",
    "inference",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\"}, namespace)",
          "refId": "ns"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\"}, model)",
          "refId": "model"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pd_role",
        "type": "query",
        "label": "P/D Role",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\"}, pd_role)",
          "refId": "role"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pd_engine",
        "type": "query",
        "label": "P/D Engine",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        },
        "query": {
          "query": "label_values(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\"}, pd_engine)",
          "refId": "engine"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Target / Traffic Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P/D Engine Targets UP",
      "description": "선택한 namespace/model 범위에서 Prometheus가 정상 scrape 중인 Prefill/Decode 엔진 수입니다. 기대 엔진 수보다 작으면 성능 지표를 보기 전에 target discovery/health부터 확인하세요.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "targets",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P/D Router Targets UP",
      "description": "Cell-local vllm-router의 :29000/metrics scrape 상태입니다. 0이면 P/D 요청 경로와 별개로 router observability가 끊긴 상태입니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kubernetes-vllm-pd-router\",namespace=~\"$namespace\",model=~\"$model\"})",
          "legendFormat": "routers",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in Selected Range",
      "description": "현재 대시보드 시간 범위($__range) 동안 완료된 요청 수입니다. 24h 같은 고정 window를 쓰지 않아 최근 5분으로 줄여도 같은 의미를 유지합니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vllm:request_success_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])) or vector(0)",
          "legendFormat": "requests",
          "interval": "15s",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Preemptions in Selected Range",
      "description": "선택한 시간 범위에서 발생한 preemption 수입니다. KV 압박이나 scheduler capacity 부족의 직접 신호입니다. 0에 가까운 상태가 정상적입니다.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vllm:num_preemptions_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])) or vector(0)",
          "legendFormat": "preemptions",
          "interval": "15s",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Throughput by Role",
      "description": "완료 요청의 초당 처리량입니다. $__rate_interval을 사용하므로 5분/1시간/1일 등 범위 변경 시 window가 자동 조정됩니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role) (rate(vllm:request_success_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])) or on (pd_role) (0 * sum by (pd_role) (up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}))",
          "legendFormat": "{{pd_role}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Running / Waiting Requests",
      "description": "실행 중 요청과 대기 요청을 엔진별로 함께 봅니다. Decode waiting이 지속 상승하면 decode capacity 부족, Prefill waiting 상승은 prompt compute/queue 병목 가능성이 큽니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_engine) (vllm:num_requests_running{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "running {{pd_engine}}",
          "interval": "15s"
        },
        {
          "refId": "B",
          "expr": "sum by (pd_engine) (vllm:num_requests_waiting{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "waiting {{pd_engine}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prompt / Generation Token Throughput",
      "description": "Prefill prompt token 처리율과 Decode generation token 처리율입니다. P/D ratio 튜닝에서 양쪽의 실제 workload 강도를 비교하는 핵심 패널입니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role) (rate(vllm:prompt_tokens_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])) or on (pd_role) (0 * sum by (pd_role) (up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}))",
          "legendFormat": "prompt {{pd_role}}",
          "interval": "15s"
        },
        {
          "refId": "B",
          "expr": "sum by (pd_role) (rate(vllm:generation_tokens_total{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__rate_interval])) or on (pd_role) (0 * sum by (pd_role) (up{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}))",
          "legendFormat": "generation {{pd_role}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Waiting Requests by Reason",
      "description": "vLLM이 capacity/deferred 이유별 waiting metric을 노출하는 버전에서 scheduler 대기 원인을 분리합니다. metric이 없는 버전에서는 이 패널만 No data일 수 있습니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pd_role,reason) (vllm:num_requests_waiting_by_reason{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"})",
          "legendFormat": "{{pd_role}} / {{reason}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "2. Latency / Request Shape",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "TTFT p50 / p95 / p99 — Selected Range",
      "description": "현재 선택한 dashboard 범위(예: Last 5m)에 포함된 TTFT histogram 증가분으로 p50/p95/p99를 계산합니다. rolling rate가 아니라 선택 범위 전체 표본을 사용하므로 짧은 수동 P/D 테스트에 적합합니다. 범위 안에 완료/첫-token 표본이 전혀 없으면 '최근 요청 없음'으로 표시됩니다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (increase(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "p50",
          "interval": "15s",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "p95",
          "interval": "15s",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "p99",
          "interval": "15s",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "최근 요청 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "ITL / TPOT p95 — Selected Range",
      "description": "현재 선택 범위의 Decode latency histogram 증가분으로 p95 ITL/TPOT을 계산합니다. vLLM 0.26.0 source 기준 ITL은 inter_token_latency_seconds, TPOT은 request_time_per_output_token_seconds입니다. 범위 안에 decode 표본이 없으면 '최근 Decode 표본 없음'으로 표시됩니다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(vllm:inter_token_latency_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "ITL p95",
          "interval": "15s",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(vllm:request_time_per_output_token_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "TPOT p95",
          "interval": "15s",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "최근 Decode 표본 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "E2E / Queue p95 — Selected Range",
      "description": "선택한 dashboard range 전체에서 E2E latency와 scheduler queue time의 p95를 계산합니다. 최근 5분 benchmark라면 정확히 그 5분 안에 관찰된 요청만 사용합니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(vllm:e2e_request_latency_seconds_bucket{job=\"kubernetes-vllm-pd-engines\",namespace=~\"$namespace\",model=~\"$model\",pd_role=~\"$pd_role\",pd_engine=~\"$pd_engine\"}[$__range])))",
          "legendFormat": "E2E p95",
          "interval": "15s",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
