            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Graphics Engine Active",
      "description": "GPU graphics/compute engine active ratio입니다. GPU_UTIL과 함께 비교하면 driver-level busy와 profiling-level engine activity를 교차검증할 수 있습니다.",
