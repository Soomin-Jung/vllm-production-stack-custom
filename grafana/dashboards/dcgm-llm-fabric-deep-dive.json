      "targets": [
        {
          "refId": "A",
          "expr": "100 * DCGM_FI_PROF_SM_OCCUPANCY{job=\"nvidia-dcgm-metrics\",instance=~\"$node\",gpu=~\"$gpu\"}",
          "legendFormat": "{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
